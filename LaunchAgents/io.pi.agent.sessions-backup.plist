<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.pi.agent.sessions-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>/bin/mkdir -p "$HOME/Dropbox/Backups/pi/agent/sessions" &amp;&amp; /usr/bin/rsync -a "$HOME/.pi/agent/sessions/" "$HOME/Dropbox/Backups/pi/agent/sessions/"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
</dict>
</plist>
