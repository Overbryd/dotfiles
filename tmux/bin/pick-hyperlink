#!/usr/bin/env python3
"""Pick an OSC 8 hyperlink from a tmux pane and copy its target."""

import re
import subprocess
import sys

OSC8_LINK = re.compile(
    rb"\x1b\]8;[^;]*;([^\x1b\x07]+)(?:\x1b\\|\x07)(.*?)\x1b\]8;;(?:\x1b\\|\x07)",
    re.DOTALL,
)
ANSI = re.compile(rb"\x1b\[[0-?]*[ -/]*[@-~]")


def message(text: str) -> None:
    subprocess.run(["tmux", "display-message", text], check=False)


def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} pane-id", file=sys.stderr)
        return 2

    capture = subprocess.run(
        ["tmux", "capture-pane", "-p", "-e", "-S", "-", "-t", sys.argv[1]],
        check=True,
        stdout=subprocess.PIPE,
    ).stdout

    links: list[tuple[str, str]] = []
    seen: set[str] = set()
    for match in reversed(list(OSC8_LINK.finditer(capture))):
        url = match.group(1).decode("utf-8", "replace").strip()
        if not url or url in seen:
            continue
        label = ANSI.sub(b"", match.group(2)).decode("utf-8", "replace")
        label = " ".join(label.split())
        links.append((label, url))
        seen.add(url)

    if not links:
        message("No hyperlinks in pane history")
        return 0

    rows = "".join(f"{index}\t{label or url}\t{url}\n" for index, (label, url) in enumerate(links))
    picker = subprocess.run(
        [
            "fzf",
            "--delimiter=\t",
            "--with-nth=2..",
            "--prompt=link> ",
            "--header=Enter: copy URL · Ctrl-O: open URL",
            "--expect=ctrl-o",
            "--reverse",
        ],
        input=rows,
        text=True,
        stdout=subprocess.PIPE,
    )
    if picker.returncode != 0:
        return 0

    output = picker.stdout.splitlines()
    key = output[0]
    selection = output[1]
    index = int(selection.split("\t", 1)[0])
    url = links[index][1]
    if key == "ctrl-o":
        subprocess.run(["open", url], check=True)
        message(f"Opened link: {url}")
    else:
        subprocess.run(["pbcopy"], input=url, text=True, check=True)
        message(f"Copied link: {url}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
