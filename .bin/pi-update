#!/usr/bin/env bash
set -euo pipefail

PACKAGE="@earendil-works/pi-coding-agent"
PREFIX="/opt/homebrew"

latest=false
case "${1:-}" in
  "") ;;
  --latest) latest=true ;;
  *)
    printf 'Usage: pi-update [--latest]\n' >&2
    exit 64
    ;;
esac
if [[ $# -gt 1 ]]; then
  printf 'Usage: pi-update [--latest]\n' >&2
  exit 64
fi

if [[ "$latest" == false ]]; then
  release_cutoff=$(npm config get before)
  if [[ -z "$release_cutoff" || "$release_cutoff" == "null" ]]; then
    printf 'pi-update: npm before cutoff is unavailable; configure min-release-age\n' >&2
    exit 1
  fi
fi

current_version=$(pi --version)
tmp_dir=$(mktemp -d /tmp/pi-update.XXXXXX)
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

if [[ "$latest" == true ]]; then
  policy="latest release"
  resolver=(npm --userconfig=/dev/null install --package-lock-only --ignore-scripts "$PACKAGE@>$current_version")
else
  policy="release cutoff $release_cutoff"
  resolver=(npm --userconfig=/dev/null install --package-lock-only --ignore-scripts --before="$release_cutoff" "$PACKAGE@>$current_version")
fi

if ! resolver_output=$(
  cd "$tmp_dir"
  "${resolver[@]}" 2>&1
); then
  if grep -Eq 'code ETARGET|No matching version found' <<< "$resolver_output"; then
    printf 'No pi update newer than %s matching %s\n' "$current_version" "$policy"
    exit 0
  fi

  printf '%s\n' "$resolver_output" >&2
  exit 1
fi

candidate_version=$(node -e '
  const lock = require(process.argv[1]);
  const version = lock.packages?.["node_modules/@earendil-works/pi-coding-agent"]?.version;
  if (!version) process.exit(1);
  process.stdout.write(version);
' "$tmp_dir/package-lock.json")

printf 'Updating pi from %s to %s (%s)\n' \
  "$current_version" "$candidate_version" "$policy"

# The exact version was vetted above. Disable project npm age policy during the
# privileged install so it cannot override an explicit --latest selection.
sudo -Eu binary env \
  HOME="$PREFIX" \
  NPM_CONFIG_MIN_RELEASE_AGE=0 \
  npm \
  --prefix "$PREFIX" \
  install \
  -g \
  --ignore-scripts \
  "$PACKAGE@$candidate_version"
