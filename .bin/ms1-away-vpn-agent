#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_NAME=$(basename "$0")
readonly SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly WG_TUNNEL_BIN_DEFAULT="$SCRIPT_DIR/wg-tunnel"
readonly AWK_BIN=/usr/bin/awk
readonly CURL_BIN=/usr/bin/curl
readonly DATE_BIN=/bin/date
readonly HOSTNAME_BIN=/bin/hostname
readonly PING_BIN=${PING_BIN:-/sbin/ping}
readonly RUBY_BIN=/usr/bin/ruby
readonly SECURITY_BIN=/usr/bin/security
readonly SED_BIN=/usr/bin/sed
readonly TR_BIN=/usr/bin/tr
readonly ID_BIN=/usr/bin/id
readonly MKDIR_BIN=/bin/mkdir
readonly RM_BIN=/bin/rm

DRY_RUN=0

usage() {
  cat <<'EOF'
Usage:
  ms1-away-vpn-agent [--dry-run] [--help]

Keeps a WireGuard tunnel healthy while Home Assistant reports away.

This script is safe to keep in a public dotfiles repo:
- it reads configuration from outside the repo by default
- it prefers Home Assistant tokens from the macOS Keychain

Default external config file:
  ~/.wg-auto/ms1.env

Recommended Keychain setup:
  security add-generic-password -U -a "$USER" -s wg-auto-home-assistant -w '<LONG_LIVED_ACCESS_TOKEN>'

Useful overrides for local testing:
  WG_AUTO_EXPECT_HOSTNAME=mba1
  WG_AUTO_HA_STATE_OVERRIDE=away
  WG_AUTO_HEALTH_STATE_OVERRIDE=healthy
  ms1-away-vpn-agent --dry-run
EOF
}

log() {
  echo "$("$DATE_BIN" '+%Y-%m-%dT%H:%M:%S%z') $*"
}

normalize() {
  printf '%s' "$1" \
    | "$TR_BIN" '[:upper:]' '[:lower:]' \
    | "$SED_BIN" 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

bool_from_text() {
  case "$(normalize "$1")" in
    1|true|yes|on|locked) echo true ;;
    0|false|no|off|unlocked) echo false ;;
    *) return 1 ;;
  esac
}

bool_to_int() {
  case "$(bool_from_text "$1")" in
    true) echo 1 ;;
    false) echo 0 ;;
  esac
}

csv_contains() {
  local csv=$1
  local needle
  local item

  needle=$(normalize "$2")
  IFS=',' read -r -a items <<< "$csv"

  for item in "${items[@]}"; do
    if [[ "$(normalize "$item")" == "$needle" ]]; then
      return 0
    fi
  done

  return 1
}

remember_state() {
  local record=$1
  "$MKDIR_BIN" -p "$WG_AUTO_STATE_DIR"
  printf '%s\n' "$record" > "$WG_AUTO_STATE_FILE"
}

last_state() {
  if [[ -f "$WG_AUTO_STATE_FILE" ]]; then
    <"$WG_AUTO_STATE_FILE" read -r record || true
    printf '%s' "${record:-}"
  fi
}

log_if_changed() {
  local record=$1
  local previous

  previous=$(last_state)
  if [[ "$record" != "$previous" ]]; then
    log "$record"
    remember_state "$record"
  fi
}

log_force() {
  local record=$1
  log "$record"
  remember_state "$record"
}

load_external_config() {
  if [[ -f "$WG_AUTO_CONFIG_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$WG_AUTO_CONFIG_FILE"
    set +a
  fi
}

current_hostname() {
  "$HOSTNAME_BIN" -s 2>/dev/null || "$HOSTNAME_BIN"
}

home_assistant_token() {
  if [[ -n "${HA_TOKEN:-}" ]]; then
    printf '%s' "$HA_TOKEN"
    return 0
  fi

  if [[ -n "${HA_TOKEN_FILE:-}" && -f "$HA_TOKEN_FILE" ]]; then
    "$AWK_BIN" 'NR == 1 { print; exit }' "$HA_TOKEN_FILE"
    return 0
  fi

  "$SECURITY_BIN" find-generic-password -w \
    -s "$HA_TOKEN_KEYCHAIN_SERVICE" \
    -a "$HA_TOKEN_KEYCHAIN_ACCOUNT"
}

home_assistant_state() {
  local token
  local response
  local url

  if [[ -n "${WG_AUTO_HA_STATE_OVERRIDE:-}" ]]; then
    printf '%s\n' "$WG_AUTO_HA_STATE_OVERRIDE"
    return 0
  fi

  token=$(home_assistant_token)
  url="${HA_URL%/}/api/states/${HA_ENTITY_ID}"

  response=$(
    "$CURL_BIN" --silent --show-error --fail --max-time 10 \
      -H "Authorization: Bearer $token" \
      -H 'Accept: application/json' \
      "$url"
  )

  printf '%s' "$response" \
    | "$RUBY_BIN" -rjson -e 'print JSON.parse(STDIN.read).fetch("state")'
}

current_tunnel_health() {
  if [[ -n "${WG_AUTO_HEALTH_STATE_OVERRIDE:-}" ]]; then
    case "$(normalize "$WG_AUTO_HEALTH_STATE_OVERRIDE")" in
      healthy) echo true ;;
      unhealthy) echo false ;;
      *) bool_from_text "$WG_AUTO_HEALTH_STATE_OVERRIDE" ;;
    esac
    return
  fi

  if "$PING_BIN" -n -c 1 -W "$WG_AUTO_PING_TIMEOUT_MS" "$WG_AUTO_HEALTHCHECK_HOST" >/dev/null 2>&1; then
    echo true
  else
    echo false
  fi
}

health_failure_count() {
  local count=0

  if [[ -f "$WG_AUTO_HEALTH_FAILURE_FILE" ]]; then
    read -r count < "$WG_AUTO_HEALTH_FAILURE_FILE" || true
  fi

  if [[ ! "$count" =~ ^[0-9]+$ ]]; then
    count=0
  fi

  printf '%s\n' "$count"
}

increment_health_failure_count() {
  local count

  count=$(health_failure_count)
  count=$((count + 1))
  "$MKDIR_BIN" -p "$WG_AUTO_STATE_DIR"
  printf '%s\n' "$count" > "$WG_AUTO_HEALTH_FAILURE_FILE"
  printf '%s\n' "$count"
}

clear_health_failures() {
  "$RM_BIN" -f "$WG_AUTO_HEALTH_FAILURE_FILE"
}

presence_from_state() {
  local state

  state=$(normalize "$1")

  case "$state" in
    ''|unknown|unavailable)
      echo unknown
      return
      ;;
  esac

  if csv_contains "$HA_AWAY_STATES" "$state"; then
    echo away
  elif csv_contains "$HA_HOME_STATES" "$state"; then
    echo home
  elif [[ "$WG_AUTO_TREAT_OTHER_STATES_AS_AWAY" == 1 ]]; then
    echo away
  else
    echo unknown
  fi
}

single_line() {
  printf '%s' "$1" | "$TR_BIN" '\n' ' '
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "$SCRIPT_NAME: unknown argument: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
  shift
done

WG_AUTO_CONFIG_FILE=${WG_AUTO_CONFIG_FILE:-$HOME/.wg-auto/ms1.env}
load_external_config

WG_AUTO_EXPECT_HOSTNAME=${WG_AUTO_EXPECT_HOSTNAME:-ms1}
WG_AUTO_TUNNEL=${WG_AUTO_TUNNEL:-ms1}
WG_TUNNEL_BIN=${WG_TUNNEL_BIN:-$WG_TUNNEL_BIN_DEFAULT}
WG_AUTO_ENABLE_DISCONNECT=$(bool_to_int "${WG_AUTO_ENABLE_DISCONNECT:-0}")
WG_AUTO_TREAT_OTHER_STATES_AS_AWAY=$(bool_to_int "${WG_AUTO_TREAT_OTHER_STATES_AS_AWAY:-0}")
WG_AUTO_HEALTHCHECK_HOST=${WG_AUTO_HEALTHCHECK_HOST:-10.10.10.1}
WG_AUTO_HEALTH_FAILURE_THRESHOLD=${WG_AUTO_HEALTH_FAILURE_THRESHOLD:-3}
WG_AUTO_PING_TIMEOUT_MS=${WG_AUTO_PING_TIMEOUT_MS:-2000}
WG_AUTO_STATE_DIR=${WG_AUTO_STATE_DIR:-$HOME/.local/state/wg-auto}
WG_AUTO_STATE_FILE=${WG_AUTO_STATE_FILE:-$WG_AUTO_STATE_DIR/ms1-away-vpn-agent.last}
WG_AUTO_HEALTH_FAILURE_FILE=${WG_AUTO_HEALTH_FAILURE_FILE:-$WG_AUTO_STATE_DIR/ms1-away-vpn-agent.health-failures}
HA_URL=${HA_URL:-}
HA_ENTITY_ID=${HA_ENTITY_ID:-}
HA_AWAY_STATES=${HA_AWAY_STATES:-on,away,not_home}
HA_HOME_STATES=${HA_HOME_STATES:-off,home}
HA_TOKEN_KEYCHAIN_SERVICE=${HA_TOKEN_KEYCHAIN_SERVICE:-wg-auto-home-assistant}
HA_TOKEN_KEYCHAIN_ACCOUNT=${HA_TOKEN_KEYCHAIN_ACCOUNT:-${USER:-$($ID_BIN -un)}}

if [[ "$(current_hostname)" != "$WG_AUTO_EXPECT_HOSTNAME" ]]; then
  exit 0
fi

if [[ ! "$WG_AUTO_HEALTH_FAILURE_THRESHOLD" =~ ^[1-9][0-9]*$ ]]; then
  log_if_changed "error=invalid-health-failure-threshold value=$WG_AUTO_HEALTH_FAILURE_THRESHOLD"
  exit 1
fi

if [[ ! "$WG_AUTO_PING_TIMEOUT_MS" =~ ^[1-9][0-9]*$ ]]; then
  log_if_changed "error=invalid-ping-timeout value=$WG_AUTO_PING_TIMEOUT_MS"
  exit 1
fi

if [[ ! -x "$WG_TUNNEL_BIN" ]]; then
  log_if_changed "error=missing-wg-tunnel path=$WG_TUNNEL_BIN"
  exit 1
fi

if [[ -z "${WG_AUTO_HA_STATE_OVERRIDE:-}" ]]; then
  if [[ -z "$HA_URL" || -z "$HA_ENTITY_ID" ]]; then
    log_if_changed "noop=config-incomplete config_file=$WG_AUTO_CONFIG_FILE missing=HA_URL_or_HA_ENTITY_ID"
    exit 0
  fi

  if ! home_assistant_token >/dev/null 2>&1; then
    log_if_changed "noop=ha-token-missing config_file=$WG_AUTO_CONFIG_FILE keychain_service=$HA_TOKEN_KEYCHAIN_SERVICE keychain_account=$HA_TOKEN_KEYCHAIN_ACCOUNT"
    exit 0
  fi
fi

ha_state=''
if ! ha_state=$(home_assistant_state 2>&1); then
  log_if_changed "error=home-assistant-query-failed detail=$(single_line "$ha_state")"
  exit 1
fi

presence=$(presence_from_state "$ha_state")

if ! tunnel_status=$("$WG_TUNNEL_BIN" status "$WG_AUTO_TUNNEL" 2>&1); then
  log_if_changed "error=tunnel-status-failed tunnel=$WG_AUTO_TUNNEL detail=$(single_line "$tunnel_status")"
  exit 1
fi

tunnel_status=$(normalize "$tunnel_status")
action=no-op
reason=''
health_failures=0

case "$presence" in
  away)
    case "$tunnel_status" in
      connected)
        if [[ "$(current_tunnel_health)" == true ]]; then
          clear_health_failures
          reason='away-and-healthy'
        else
          health_failures=$(increment_health_failure_count)
          if (( health_failures >= WG_AUTO_HEALTH_FAILURE_THRESHOLD )); then
            action=restart
            reason='away-and-healthcheck-failed'
          else
            reason="away-and-healthcheck-failed-${health_failures}-of-${WG_AUTO_HEALTH_FAILURE_THRESHOLD}"
          fi
        fi
        ;;
      connecting|reasserting|disconnecting)
        reason="away-and-tunnel-$tunnel_status"
        ;;
      *)
        action=start
        reason='away-and-disconnected'
        ;;
    esac
    ;;

  home)
    clear_health_failures
    if [[ "$tunnel_status" == disconnected || "$tunnel_status" == invalid ]]; then
      reason='home-and-tunnel-already-disconnected'
    elif [[ "$WG_AUTO_ENABLE_DISCONNECT" == 1 ]]; then
      action=stop
      reason='home-and-disconnect-enabled'
    else
      reason='home-and-disconnect-disabled'
    fi
    ;;

  *)
    reason="presence-unknown-for-state-$(single_line "$ha_state")"
    ;;
esac

summary="state=presence:$presence ha:$ha_state tunnel_status:$tunnel_status health_failures:$health_failures action:$action reason:$reason"

case "$action" in
  start)
    if (( DRY_RUN )); then
      log_force "dry_run=1 tunnel=$WG_AUTO_TUNNEL action=start ha_state=$ha_state reason=$reason"
      exit 0
    fi

    if result=$("$WG_TUNNEL_BIN" start "$WG_AUTO_TUNNEL" 2>&1); then
      clear_health_failures
      log_force "tunnel=$WG_AUTO_TUNNEL action=start result=$(single_line "$result") ha_state=$ha_state reason=$reason"
      exit 0
    fi

    log_force "error=tunnel-start-failed tunnel=$WG_AUTO_TUNNEL detail=$(single_line "$result")"
    exit 1
    ;;

  restart)
    if (( DRY_RUN )); then
      log_force "dry_run=1 tunnel=$WG_AUTO_TUNNEL action=restart ha_state=$ha_state reason=$reason"
      exit 0
    fi

    if ! stop_result=$("$WG_TUNNEL_BIN" stop "$WG_AUTO_TUNNEL" 2>&1); then
      log_force "error=tunnel-restart-stop-failed tunnel=$WG_AUTO_TUNNEL detail=$(single_line "$stop_result")"
      exit 1
    fi

    if start_result=$("$WG_TUNNEL_BIN" start "$WG_AUTO_TUNNEL" 2>&1); then
      clear_health_failures
      log_force "tunnel=$WG_AUTO_TUNNEL action=restart stop_result=$(single_line "$stop_result") start_result=$(single_line "$start_result") ha_state=$ha_state reason=$reason"
      exit 0
    fi

    log_force "error=tunnel-restart-start-failed tunnel=$WG_AUTO_TUNNEL detail=$(single_line "$start_result")"
    exit 1
    ;;

  stop)
    if (( DRY_RUN )); then
      log_force "dry_run=1 tunnel=$WG_AUTO_TUNNEL action=stop ha_state=$ha_state reason=$reason"
      exit 0
    fi

    if result=$("$WG_TUNNEL_BIN" stop "$WG_AUTO_TUNNEL" 2>&1); then
      clear_health_failures
      log_force "tunnel=$WG_AUTO_TUNNEL action=stop result=$(single_line "$result") ha_state=$ha_state reason=$reason"
      exit 0
    fi

    log_force "error=tunnel-stop-failed tunnel=$WG_AUTO_TUNNEL detail=$(single_line "$result")"
    exit 1
    ;;

  *)
    log_if_changed "$summary"
    ;;
esac
