#!/usr/bin/python3

"""wg-log: print the WireGuard app tunnel log.

The macOS WireGuard app writes its tunnel log into a binary ring buffer inside its
group container instead of the unified log. Layout:

    offset 0        UInt64  write index (little endian, monotonically increasing)
    offset 8+k*520  UInt64  timestamp in nanoseconds since the epoch
    offset 16+k*520 char    NUL-padded message, 512 bytes

The ring holds 2048 slots, the next slot to be written is `index % 2048`.
"""

import argparse
import os
import re
import struct
import sys
import time
from datetime import datetime
from pathlib import Path


DEFAULT_LOG = (
    Path.home()
    / "Library/Group Containers/L82V4Y2P3C.group.com.wireguard.macos/tunnel-log.bin"
)
HEADER_SIZE = 8
MESSAGE_SIZE = 512
ENTRY_SIZE = 8 + MESSAGE_SIZE
INTERESTING = (
    r"Failed to send|no route to host|broken pipe|Network change|UDP bind|"
    r"[Hh]andshake|status changed|Starting tunnel|Stopping tunnel|Tunnel interface|"
    r"startActivation|startDeactivation|Interface up"
)


def read_log(path):
    data = path.read_bytes()
    if len(data) < HEADER_SIZE + ENTRY_SIZE:
        raise SystemExit("wg-log: {} is too small to be a tunnel log".format(path))

    index = struct.unpack_from("<Q", data, 0)[0]
    slots = (len(data) - HEADER_SIZE) // ENTRY_SIZE
    entries = []

    for slot in range(slots):
        offset = HEADER_SIZE + slot * ENTRY_SIZE
        timestamp = struct.unpack_from("<Q", data, offset)[0]
        if not timestamp:
            continue
        message = data[offset + 8 : offset + ENTRY_SIZE].split(b"\0", 1)[0]
        entries.append((timestamp, message.decode("utf8", "replace")))

    entries.sort(key=lambda entry: entry[0])
    return index, entries


def collapse(entries):
    collapsed = []
    for timestamp, message in entries:
        if collapsed and collapsed[-1][2] == message:
            collapsed[-1][1] = timestamp
            collapsed[-1][3] += 1
            continue
        collapsed.append([timestamp, timestamp, message, 1])
    return collapsed


def stamp(timestamp):
    return datetime.fromtimestamp(timestamp / 1e9).strftime("%m-%d %H:%M:%S.%f")[:-3]


def emit(entries, collapsed):
    if not collapsed:
        for timestamp, message in entries:
            print("{} {}".format(stamp(timestamp), message))
        return

    for first, last, message, count in collapse(entries):
        if count == 1:
            print("{} {}".format(stamp(first), message))
        else:
            print("{} {}  [x{} until {}]".format(stamp(first), message, count, stamp(last)))


def main(argv):
    parser = argparse.ArgumentParser(prog="wg-log", description="print the WireGuard app tunnel log")
    parser.add_argument("-n", "--lines", type=int, default=200, help="number of entries to print (default 200)")
    parser.add_argument("-a", "--all", action="store_true", help="print the whole ring buffer")
    parser.add_argument("-f", "--follow", action="store_true", help="keep printing new entries")
    parser.add_argument("-g", "--grep", metavar="PATTERN", help="only print matching entries")
    parser.add_argument("-e", "--errors", action="store_true", help="only print connection lifecycle and send errors")
    parser.add_argument("-c", "--collapse", action="store_true", help="collapse repeated messages")
    parser.add_argument("--file", type=Path, default=Path(os.environ.get("WG_LOG_FILE", DEFAULT_LOG)))
    args = parser.parse_args(argv)

    if not args.file.exists():
        raise SystemExit("wg-log: no tunnel log at {}".format(args.file))

    pattern = None
    if args.errors and args.grep:
        pattern = re.compile("(?:{})|(?:{})".format(INTERESTING, args.grep))
    elif args.errors:
        pattern = re.compile(INTERESTING)
    elif args.grep:
        pattern = re.compile(args.grep)

    def select(entries):
        if pattern is None:
            return entries
        return [entry for entry in entries if pattern.search(entry[1])]

    index, entries = read_log(args.file)
    selected = select(entries)
    if not args.all:
        selected = selected[-max(args.lines, 0) :]
    emit(selected, args.collapse)
    sys.stdout.flush()

    if not args.follow:
        return 0

    seen = entries[-1][0] if entries else 0
    while True:
        time.sleep(0.5)
        new_index, entries = read_log(args.file)
        if new_index == index:
            continue
        index = new_index
        fresh = select([entry for entry in entries if entry[0] > seen])
        if fresh:
            seen = max(entry[0] for entry in entries)
            emit(fresh, args.collapse)
            sys.stdout.flush()


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
