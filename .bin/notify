#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"${HOME}/.config"}
config_file="$config_home/notify/config"
script_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)

usage() {
	cat <<'EOF'
Usage:
  notify setup [TOPIC_OR_URL]
  notify TITLE MESSAGE

Environment:
  NOTIFY_URL     Override the saved topic URL
  NOTIFY_TOKEN   Optional ntfy access token
EOF
}

fail() {
	printf 'notify: %s\n' "$*" >&2
	usage >&2
	exit 64
}

setup_notify() {
	[ "$#" -le 1 ] || fail 'setup accepts at most one topic or URL'
	topic=${1:-"$("$script_dir/random-pet")"}

	case "$topic" in
		http://*|https://*) url=$topic ;;
		*[!A-Za-z0-9_-]*) fail 'topic may contain only letters, digits, _ and -' ;;
		*) url="https://ntfy.sh/$topic" ;;
	esac
	case "$url" in *'
'*) fail 'topic URL must be a single line' ;; esac

	umask 077
	mkdir -p "$(dirname "$config_file")"
	printf 'url=%s\n' "$url" > "$config_file"
	chmod 600 "$config_file"
	printf 'Configured ntfy topic: %s\n' "$url"
}

load_config() {
	url=${NOTIFY_URL:-}
	token=${NOTIFY_TOKEN:-}
	if [ -f "$config_file" ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			case "$line" in
				url=*) [ -n "$url" ] || url=${line#url=} ;;
				token=*) [ -n "$token" ] || token=${line#token=} ;;
			esac
		done < "$config_file"
	fi
	[ -n "$url" ] || fail 'not configured; run: notify setup'
}

send_notification() {
	[ "$#" -eq 2 ] || fail 'title and message are required'
	title=$1
	message=$2
	[ -n "$title" ] || fail 'title must not be empty'
	[ -n "$message" ] || fail 'message must not be empty'
	case "$title" in *'
'*) fail 'title must be a single line' ;; esac

	load_config
	set -- --fail-with-body --silent --show-error --max-time 10 -H "Title: $title"
	if [ -n "$token" ]; then
		set -- "$@" -H "Authorization: Bearer $token"
	fi
	printf '%s' "$message" | curl "$@" --data-binary @- -- "$url" >/dev/null
}

case "${1:-}" in
	setup) shift; setup_notify "$@" ;;
	-h|--help|help) usage ;;
	*) send_notification "$@" ;;
esac
