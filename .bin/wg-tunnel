#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_NAME=$(basename "$0")
readonly SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly SOURCE=${WG_TUNNEL_SWIFT_SOURCE:-$SCRIPT_DIR/wg-tunnel.swift}
readonly CACHE_DIR=${WG_TUNNEL_CACHE_DIR:-$HOME/Library/Caches/com.overbryd.wg-tunnel}
readonly CACHE_BIN="$CACHE_DIR/wg-tunnel"
readonly SWIFTC_BIN=${SWIFTC_BIN:-/usr/bin/swiftc}

fail() {
  echo "$SCRIPT_NAME: $*" >&2
  exit 1
}

[[ -f "$SOURCE" ]] || fail "missing NetworkExtension helper source: $SOURCE"
[[ -x "$SWIFTC_BIN" ]] || fail "Swift compiler not found: $SWIFTC_BIN"

if [[ ! -x "$CACHE_BIN" || "$SOURCE" -nt "$CACHE_BIN" ]]; then
  /bin/mkdir -p "$CACHE_DIR"
  temporary_bin="$CACHE_BIN.$$"
  trap '/bin/rm -f "$temporary_bin"' EXIT

  if ! "$SWIFTC_BIN" "$SOURCE" -o "$temporary_bin"; then
    fail "failed to compile NetworkExtension helper"
  fi

  /bin/mv -f "$temporary_bin" "$CACHE_BIN"
  trap - EXIT
fi

exec "$CACHE_BIN" "$@"
