#!/usr/bin/env bash
set -euo pipefail

TMUX_BIN=${TMUX_BIN:-tmux}
TMUX_SOCKET=${TMUX_SOCKET:-}
FZF_BIN=${FZF_BIN:-fzf}
PROMPT=${TMS_PROMPT:-"open> "}
FZF_OPTS=${TMS_FZF_OPTS:-"--height 100% --reverse"}
WORK_ROOT=${TMS_WORK_ROOT:-$HOME/Work}
PROJECTS_ROOT=${TMS_PROJECTS_ROOT:-$HOME/Projects}
VIEW_NAME=${TMS_VIEW:-}
SWITCH_CLIENT=${TMS_SWITCH_CLIENT:-0}
STATE_DIR=${TMS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tms}
RECENTS_FILE=${TMS_RECENTS_FILE:-$STATE_DIR/recent.tsv}
TAB=$'\t'

usage() {
  cat <<'EOF'
Usage: tms [--list] [directory]
       tms --new [directory]

Without arguments, pick a directory with fzf and open/switch a tmux session there.
With a directory argument, open/switch directly.
Each directory has one stable project session; clients use grouped
<project>/<host>-local views that share windows but navigate independently.
With --new, always start another independent view of the shared project windows.
With --list, print candidates and exit.
EOF
}

tmux_cmd() {
  if [[ -n "$TMUX_SOCKET" ]]; then
    "$TMUX_BIN" -L "$TMUX_SOCKET" "$@"
  else
    "$TMUX_BIN" "$@"
  fi
}

exec_tmux() {
  if [[ -n "$TMUX_SOCKET" ]]; then
    exec "$TMUX_BIN" -L "$TMUX_SOCKET" "$@"
  else
    exec "$TMUX_BIN" "$@"
  fi
}

canonical_path() {
  (
    cd "$1" 2>/dev/null
    pwd -P
  )
}

if [[ -d "$WORK_ROOT" ]]; then
  WORK_ROOT=$(canonical_path "$WORK_ROOT")
fi

if [[ -d "$PROJECTS_ROOT" ]]; then
  PROJECTS_ROOT=$(canonical_path "$PROJECTS_ROOT")
fi

pretty_path() {
  local path=$1

  case "$path" in
    "$HOME")
      printf '~\n'
      ;;
    "$HOME"/*)
      printf '~/%s\n' "${path#$HOME/}"
      ;;
    *)
      printf '%s\n' "$path"
      ;;
  esac
}

session_label_for_path() {
  local path=$1
  local base parent label

  base=$(basename "$path")
  parent=$(basename "$(dirname "$path")")

  case "$path" in
    "$PROJECTS_ROOT"/*/*)
      label="$parent/$base"
      ;;
    *)
      label="$base"
      ;;
  esac

  printf '%s\n' "$label"
}

safe_name() {
  local raw=$1

  raw=${raw// /-}
  raw=${raw//:/-}
  raw=$(printf '%s' "$raw" | tr -cd '[:alnum:]_./-')
  raw=$(printf '%s' "$raw" | sed -E 's#/{2,}#/#g; s#^/+##; s#/+$##')

  [[ -n "$raw" ]] || raw=main
  printf '%s\n' "$raw"
}

project_name_for_path() {
  safe_name "$(session_label_for_path "$1")"
}

default_view_name() {
  local host

  host=${HOSTNAME:-$(hostname -s 2>/dev/null || hostname)}
  host=${host%%.*}
  safe_name "${host}-local"
}

session_root() {
  local session=$1
  local root

  root=$(tmux_cmd show-options -qv -t "$session" @tms-root 2>/dev/null || true)
  if [[ -z "$root" ]]; then
    root=$(tmux_cmd display-message -p -t "$session:" '#{session_path}' 2>/dev/null || true)
  fi
  [[ -n "$root" ]] && canonical_path "$root" 2>/dev/null || true
}

project_sessions_for_path() {
  local target=$1
  local session root

  tmux_cmd list-sessions -F '#{session_name}' 2>/dev/null | while IFS= read -r session; do
    root=$(session_root "$session")
    [[ "$root" == "$target" ]] && printf '%s\n' "$session"
  done
}

ensure_project_anchor() {
  local target=$1
  local project=$2
  local role root
  local -a legacy=()

  if tmux_cmd has-session -t "$project" 2>/dev/null; then
    root=$(session_root "$project")
    if [[ "$root" != "$target" ]]; then
      printf 'tms: session name %s already belongs to %s\n' "$project" "$root" >&2
      return 1
    fi
  else
    while IFS= read -r session; do
      role=$(tmux_cmd show-options -qv -t "$session" @tms-role 2>/dev/null || true)
      [[ "$role" == view ]] || legacy+=("$session")
    done < <(project_sessions_for_path "$target")

    if [[ ${#legacy[@]} -eq 1 ]]; then
      tmux_cmd rename-session -t "${legacy[0]}" -n "$project"
    elif [[ ${#legacy[@]} -gt 1 ]]; then
      printf 'tms: multiple legacy sessions use %s: %s\n' "$target" "${legacy[*]}" >&2
      printf 'tms: refusing to merge live sessions; keep one project session, then retry\n' >&2
      return 1
    else
      tmux_cmd new-session -d -s "$project" -c "$target"
    fi
  fi

  tmux_cmd set-option -q -t "$project" @tms-root "$target"
  tmux_cmd set-option -q -t "$project" @tms-role anchor
  tmux_cmd set-option -q -t "$project" @tms-project "$project"
}

current_view_name() {
  local current view

  if [[ -n "${TMUX:-}" ]]; then
    current=$(tmux_cmd display-message -p '#S' 2>/dev/null || true)
    if [[ -n "$current" ]]; then
      view=$(tmux_cmd show-options -qv -t "$current" @tms-view 2>/dev/null || true)
      [[ -n "$view" ]] && { printf '%s\n' "$view"; return; }
    fi
  fi

  safe_name "${VIEW_NAME:-$(default_view_name)}"
}

available_view_name() {
  local project=$1
  local requested=$2
  local force_new=$3
  local candidate attached current i

  candidate="$project/$requested"
  current=$(tmux_cmd display-message -p '#S' 2>/dev/null || true)
  i=2

  while tmux_cmd has-session -t "$candidate" 2>/dev/null; do
    attached=$(tmux_cmd display-message -p -t "$candidate:" '#{session_attached}' 2>/dev/null || printf '1')
    if [[ "$force_new" != true && ( "$candidate" == "$current" || "$attached" == 0 ) ]]; then
      printf '%s\n' "$candidate"
      return
    fi
    candidate="$project/$requested-$i"
    i=$((i + 1))
  done

  printf '%s\n' "$candidate"
}

ensure_view() {
  local project=$1
  local target=$2
  local requested=$3
  local force_new=$4
  local session view

  session=$(available_view_name "$project" "$requested" "$force_new")
  view=${session#"$project/"}

  if ! tmux_cmd has-session -t "$session" 2>/dev/null; then
    tmux_cmd new-session -d -s "$session" -t "$project" -c "$target"
  fi

  tmux_cmd set-option -q -t "$session" @tms-root "$target"
  tmux_cmd set-option -q -t "$session" @tms-role view
  tmux_cmd set-option -q -t "$session" @tms-project "$project"
  tmux_cmd set-option -q -t "$session" @tms-view "$view"
  printf '%s\n' "$session"
}

record_recent() {
  local target=$1
  local tmp

  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "${TMPDIR:-/tmp}/tms-recent.XXXXXX")

  {
    printf '%s\t%s\n' "$(date +%s)" "$target"
    if [[ -f "$RECENTS_FILE" ]]; then
      awk -F '\t' -v path="$target" '$2 != path { print $0 }' "$RECENTS_FILE" | head -n 199
    fi
  } > "$tmp"

  mv "$tmp" "$RECENTS_FILE"
}

emit_open_sessions() {
  local activity session path label pretty

  if ! tmux_cmd list-sessions >/dev/null 2>&1; then
    return
  fi

  tmux_cmd list-sessions -F '#{session_activity}\t#{session_name}' \
    | sort -t "$TAB" -k1,1nr \
    | while IFS="$TAB" read -r activity session; do
        path=$(tmux_cmd show-options -qv -t "$session" @tms-root 2>/dev/null || true)

        if [[ -z "$path" ]]; then
          path=$(tmux_cmd display-message -p -t "$session:" '#{session_path}' 2>/dev/null || true)
        fi

        [[ -n "$path" ]] || continue
        path=$(canonical_path "$path" 2>/dev/null || true)
        [[ -d "$path" ]] || continue

        label=$(session_label_for_path "$path")
        pretty=$(pretty_path "$path")

        printf 'open\t%s\t[open]   %-24s %s\n' "$path" "$label" "$pretty"
      done
}

emit_recent_paths() {
  local path label pretty

  [[ -f "$RECENTS_FILE" ]] || return

  sort -t "$TAB" -k1,1nr "$RECENTS_FILE" | while IFS="$TAB" read -r _ path; do
    [[ -n "$path" ]] || continue
    path=$(canonical_path "$path" 2>/dev/null || true)
    [[ -d "$path" ]] || continue

    label=$(session_label_for_path "$path")
    pretty=$(pretty_path "$path")
    printf 'recent\t%s\t[recent] %-24s %s\n' "$path" "$label" "$pretty"
  done
}

emit_work_paths() {
  local path label pretty

  [[ -d "$WORK_ROOT" ]] || return

  find "$WORK_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | LC_ALL=C sort | while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    path=$(canonical_path "$path" 2>/dev/null || true)
    [[ -d "$path" ]] || continue

    label=$(session_label_for_path "$path")
    pretty=$(pretty_path "$path")
    printf 'work\t%s\t[work]   %-24s %s\n' "$path" "$label" "$pretty"
  done
}

emit_project_paths() {
  local path label pretty

  [[ -d "$PROJECTS_ROOT" ]] || return

  find "$PROJECTS_ROOT" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | LC_ALL=C sort | while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    path=$(canonical_path "$path" 2>/dev/null || true)
    [[ -d "$path" ]] || continue

    label=$(session_label_for_path "$path")
    pretty=$(pretty_path "$path")
    printf 'project\t%s\t[proj]   %-24s %s\n' "$path" "$label" "$pretty"
  done
}

build_candidates() {
  local raw seen out kind path display

  raw=$(mktemp "${TMPDIR:-/tmp}/tms-raw.XXXXXX")
  seen=$(mktemp "${TMPDIR:-/tmp}/tms-seen.XXXXXX")
  out=$(mktemp "${TMPDIR:-/tmp}/tms-out.XXXXXX")

  emit_open_sessions > "$raw"
  emit_recent_paths >> "$raw"
  emit_work_paths >> "$raw"
  emit_project_paths >> "$raw"

  : > "$seen"
  : > "$out"

  while IFS="$TAB" read -r kind path display; do
    [[ -n "$path" ]] || continue
    [[ -d "$path" ]] || continue

    if grep -Fqx "$path" "$seen" 2>/dev/null; then
      continue
    fi

    printf '%s\n' "$path" >> "$seen"
    printf '%s\t%s\t%s\n' "$kind" "$path" "$display" >> "$out"
  done < "$raw"

  rm -f "$raw" "$seen"
  printf '%s\n' "$out"
}

open_target() {
  local target=$1
  local force_new=${2:-false}
  local project requested session

  target=$(canonical_path "$target")

  if [[ ! -d "$target" ]]; then
    printf 'tms: not a directory: %s\n' "$target" >&2
    exit 1
  fi

  project=$(project_name_for_path "$target")
  requested=$(current_view_name)
  ensure_project_anchor "$target" "$project"
  session=$(ensure_view "$project" "$target" "$requested" "$force_new")
  record_recent "$target"

  if [[ -n "${TMUX:-}" ]]; then
    if [[ "$SWITCH_CLIENT" == 1 ]]; then
      tmux_cmd switch-client -t "$session"
    else
      tmux_cmd attach-session -f active-pane -c "$target" -t "$session"
    fi
  else
    exec_tmux attach-session -f active-pane -c "$target" -t "$session"
  fi
}

list_only=false
new_session=false
selected_path=

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --list)
    list_only=true
    shift
    ;;
  --new)
    new_session=true
    shift
    ;;
  '')
    ;;
  *)
    selected_path=$1
    shift
    ;;
esac

if [[ -z "$selected_path" && $# -gt 0 ]]; then
  selected_path=$1
  shift
fi

if [[ $# -gt 0 ]]; then
  usage >&2
  exit 1
fi

if [[ -n "$selected_path" ]]; then
  open_target "$selected_path" "$new_session"
  exit 0
fi

candidates=$(build_candidates)
trap 'rm -f "$candidates"' EXIT

if [[ "$list_only" == true ]]; then
  cat "$candidates"
  exit 0
fi

if ! command -v "$FZF_BIN" >/dev/null 2>&1; then
  printf 'tms: fzf is not installed\n' >&2
  exit 1
fi

if [[ ! -s "$candidates" ]]; then
  printf 'tms: no matching directories found\n' >&2
  exit 1
fi

choice=$(
  "$FZF_BIN" \
    --prompt "$PROMPT" \
    --delimiter '\t' \
    --with-nth=3.. \
    $FZF_OPTS < "$candidates"
)

if [[ -z "${choice:-}" ]]; then
  exit 0
fi

selected_path=${choice#*$TAB}
selected_path=${selected_path%%$TAB*}
open_target "$selected_path" "$new_session"
